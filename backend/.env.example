# Copy this file to .env and fill in real values. Never commit .env.

# --- App ---
APP_NAME=PLACER API
APP_ENV=development
DEBUG=true

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=CHANGE_ME_IN_PRODUCTION
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
BCRYPT_ROUNDS=12

# --- Database ---
# Local dev (docker-compose):
MONGODB_URI=mongodb://localhost:27017
# MongoDB Atlas (production):
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=placer_db

# --- CORS ---
CORS_ORIGINS=["http://localhost:3000"]

# --- Auth cookie ---
# Set COOKIE_SECURE=true in production (requires HTTPS).
COOKIE_SECURE=false
COOKIE_DOMAIN=

# --- Google OAuth ("Sign in with Google") ---
# Free. Get one at https://console.cloud.google.com/apis/credentials
# -> Create Credentials -> OAuth client ID -> Web application
# -> Authorized JavaScript origins: http://localhost:3000 (and your prod domain)
# No client secret needed for this flow.
GOOGLE_CLIENT_ID=

# --- Storage ---
STORAGE_BACKEND=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
LOCAL_STORAGE_PATH=./storage
MAX_RESUME_SIZE_MB=5

# --- Rate limiting ---
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_AUTH=10/minute
